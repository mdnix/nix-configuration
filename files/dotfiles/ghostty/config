# Palette generated by modules/theme/gruvbox.nix.
config-file = /home/marco/.config/theme/ghostty-colors
#window-decoration = none
gtk-titlebar = false
font-family = DepartureMono Nerd Font
# One weight exists, so bold/italic are pinned to it rather than faux-styled
# or swapped to a non-pixel fallback face.
font-family-bold = DepartureMono Nerd Font
font-family-italic = DepartureMono Nerd Font
font-family-bold-italic = DepartureMono Nerd Font
font-synthetic-style = false
font-size = 12
# font-thicken fattens stems, which blurs a pixel grid.
font-thicken = false
font-feature = -liga
font-feature = -calt
font-feature = -dlig
#background-opacity = 0.95
#background-blur-radius = 70
window-padding-x = 18
window-padding-y = 16
window-height = 75
window-width = 260
window-save-state = always
